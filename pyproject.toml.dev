[build-system]
requires = ["flit_core==3.12.0"]
build-backend = "flit_core.buildapi"

[project]
name = "norman-utils"
description = "norman utils common classes"
version = "0.0.1"
readme = "README.md"
license = {text = "Apache-2.0"}
authors = [
    {name = "Norman Artificial Intelligence LTD", email = "contact@norman-ai.com"},
]

requires-python = ">=3.10"
dependencies = [
    "norman-exceptions",
    "norman-objects",

    "cryptography==46.0.5"
]

[project.optional-dependencies]
dev = [
    "pip==26.1.2" # Not needed, but used by some IDEs for package detection.
]

[tool.flit.module]
name = "norman_utils"

[tool.uv.sources]
norman-exceptions = { path = "../norman_exceptions", editable = true }
norman-objects = { path = "../norman_objects", editable = true }
